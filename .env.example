# The admin dashboard talks to the Signal Face API and nothing else — it needs no
# database, mail or Firebase credentials of its own. (This file previously held a
# copy of the API's variables, none of which this app reads.)
#
# Production: point at the deployed API.
#   NEXT_PUBLIC_API_URL="https://signalface-api.onrender.com/api"
#
# Local development: copy to `.env.development` and use your machine's LAN
# address rather than localhost, so the dashboard also works from a phone on the
# same network. Find it with:  ipconfig getifaddr en0
NEXT_PUBLIC_API_URL="http://192.168.1.100:3005/api"
